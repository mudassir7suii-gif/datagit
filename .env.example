# DataGit Configuration
# Copy this file to .env and adjust variables as needed

# Mode & Security
DATAGIT_DEBUG=true
DATAGIT_JWT_SECRET=your-secure-jwt-secret-key-at-least-32-chars
DATAGIT_AUTH_RATE_LIMIT=20

# Storage
# For SQLite (local):
DATAGIT_DATABASE_URL=sqlite:///datagit.db
# For PostgreSQL / Supabase / Neon (production):
# DATAGIT_DATABASE_URL=postgresql://user:password@host:5432/dbname

# CORS Origins (comma-separated)
DATAGIT_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# GitHub API Personal Access Tokens (comma-separated for rate limit rotation)
DATAGIT_GITHUB_TOKENS=
