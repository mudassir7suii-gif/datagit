# ==============================================================================
# DataGit Developer SaaS — Environment Configuration
# ==============================================================================

# Core Database (PostgreSQL in production, SQLite for fast local development)
DATAGIT_DATABASE_URL=postgresql://datagit:datagit_secret@localhost:5432/datagit
# DATAGIT_DATABASE_URL=sqlite:///./datagit.db

# Shared Cache & Rate Limiting (Redis)
DATAGIT_REDIS_URL=redis://localhost:6379/0

# Security Perimeter (Fail-Closed in Production per Constitution Principle 1)
DATAGIT_JWT_SECRET=generate_with_openssl_rand_hex_32
DATAGIT_ENCRYPTION_KEY=generate_with_fernet_key
DATAGIT_JWT_EXPIRATION_MINUTES=1440
DATAGIT_DEBUG=false
DATAGIT_ALLOWED_ORIGINS=["http://localhost:3000","https://app.datagit.dev"]

# GitHub API Credentials & Token Pools (Encrypted at Rest)
GITHUB_TOKEN=ghp_your_github_personal_access_token_here

# Object Storage Backend (local, s3, r2, or minio)
DATAGIT_STORAGE_BACKEND=local
DATAGIT_STORAGE_LOCAL_DIR=./exports
# DATAGIT_STORAGE_BACKEND=s3
# DATAGIT_S3_BUCKET=datagit-exports-production
# DATAGIT_S3_REGION=us-east-1
# DATAGIT_S3_ENDPOINT=https://s3.amazonaws.com
# DATAGIT_AWS_ACCESS_KEY_ID=your_aws_key
# DATAGIT_AWS_SECRET_ACCESS_KEY=your_aws_secret

# Stripe Billing & Subscriptions (Optional for Dev, Required for Live SaaS Payments)
DATAGIT_STRIPE_SECRET_KEY=sk_test_51...
DATAGIT_STRIPE_WEBHOOK_SECRET=whsec_...

# Webhook Outbound Dispatcher
DATAGIT_WEBHOOK_TIMEOUT_SECONDS=10
